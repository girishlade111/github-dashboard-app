# WARNING: this file contains LIVE secrets and is opted into git by .gitignore
# (.env* with !.env.example). Do not commit it. Use .env.local (gitignored)
# for real values and keep placeholders here before pushing.

# Copy to .env.local for local dev. Never commit a real .env file.

# Neon Postgres connection string (Neon dashboard → Connection Details)
DATABASE_URL=

# Neon Auth (Managed Better Auth) base URL — e.g. https://<project>.neon.tech
# This is your auth backend; /api/auth/* proxies to it.
NEON_AUTH_BASE_URL=

# Cookie encryption secret for Neon Auth sessions (min 32 chars, random)
NEON_AUTH_COOKIE_SECRET=

# Shared secret guarding /api/cron/sync (must match Vercel Cron's Authorization header)
CRON_SECRET=

# Dedicated GitHub OAuth App for full-access sync (repo + read:packages).
# Register at github.com/settings/applications/new with callback
# http(s)://<host>/api/github/callback. Server-only — never NEXT_PUBLIC_.
GITHUB_SYNC_CLIENT_ID=
GITHUB_SYNC_CLIENT_SECRET=
